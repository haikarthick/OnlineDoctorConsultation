# ═══════════════════════════════════════════════════════════════
#  VetCare Platform — Production Environment Template
#  Copy this file to .env and fill in ALL values before deploying.
#  NEVER commit the actual .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_VERSION=v1
# Full public URL of the frontend (used for CORS, email links, etc.)
APP_URL=https://your-domain.com

# ── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=vetcare_app
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DB_NAME=veterinary_consultation
DB_POOL_MIN=5
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
# Max queries per connection before recycling (prevents memory leaks)
DB_POOL_MAX_USES=7500
DB_SSL=true

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ── JWT / Auth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Supports multiple origins: separate with commas (no spaces around commas)
# CORS_ORIGIN=https://your-domain.com,https://admin.your-domain.com
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=warn

# ── Feature Flags ────────────────────────────────────────────
FEATURE_REDIS_CACHE=true
FEATURE_PAYMENTS=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_FILE_STORAGE=false
FEATURE_REALTIME_CHAT=true
FEATURE_OAUTH_SSO=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_AUDIT_LOGGING=true
FEATURE_ADVANCED_RATE_LIMITING=true
FEATURE_ANALYTICS=false

# ── Email (SMTP) ─────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@your-domain.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=VetCare <noreply@your-domain.com>

# ── File Storage ──────────────────────────────────────────────
# Leave STORAGE_DRIVER unset (defaults to 'local', dev-only disk storage) or
# set to 'cloudinary' + CLOUDINARY_URL to enable Cloudinary-backed uploads
# (marketplace images/video). Get CLOUDINARY_URL from your Cloudinary
# dashboard's "API Environment variable" field.
# STORAGE_DRIVER=cloudinary
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── AI / LLM ────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# ── Emergency Diagnostics (break-glass) ─────────────────────
# Unlocks GET /api/v1/debug/db-state and POST /api/v1/repair-schema, used when a
# deploy leaves the database in a state the app cannot start against. Login
# cannot gate these — if the schema is broken nobody can log in to authorise the
# repair — so they take a pre-shared token in the `x-emergency-token` header.
# LEAVE THIS UNSET unless you are actively in an incident: while unset both
# endpoints return 404 and cannot run. Minimum 16 characters; use a random value.
#   curl -H "x-emergency-token: $EMERGENCY_DIAGNOSTIC_TOKEN" .../api/v1/debug/db-state
# EMERGENCY_DIAGNOSTIC_TOKEN=

# ── Cluster Mode (non-Docker deployments only) ──────────────
# Number of Node.js worker processes. 0 or unset = one per CPU core.
# In Docker/ECS, leave unset and scale horizontally with containers.
# CLUSTER_WORKERS=4

# ── Docker Compose Overrides (used in docker-compose.prod.yml)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DOCKER_REGISTRY=ghcr.io/your-org/vetcare
IMAGE_TAG=latest
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com
