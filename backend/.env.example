# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=veterinary_consultation
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info

# Mock services (set to true for local dev without Docker)
MOCK_DB=true
MOCK_REDIS=true

# AI Copilot (OpenAI)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Razorpay (payment module — only read when payment.gatewayMode is
# razorpay_test/razorpay_live via the admin Payment Gateway TEST/LIVE buttons;
# demo mode needs none of these). Get test-mode keys (no KYC required) from
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
# Only required for the async webhook endpoint (POST /webhooks/razorpay), not
# for interactive checkout — safe to leave blank until webhook setup.
RAZORPAY_WEBHOOK_SECRET=
