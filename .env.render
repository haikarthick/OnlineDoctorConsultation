# ─────────────────────────────────────────────────────────────
# VetCare — Render.com Environment Variables
# ─────────────────────────────────────────────────────────────
# Upload this file via Render Dashboard → Environment → "Add from .env"
# DATABASE_URL is auto-injected by the render.yaml blueprint — no need to add it here.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=10000
API_VERSION=v1
MOCK_DB=false
MOCK_REDIS=true

# JWT
JWT_SECRET=vetcare-d3v-s3cr3t-a7b9c2e4f6d8a1b3c5e7f9d2a4b6c8e0f1d3a5b7c9e1f3d5
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Feature Flags
FEATURE_REDIS_CACHE=false
FEATURE_PAYMENTS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_FILE_STORAGE=false
FEATURE_REALTIME_CHAT=false
FEATURE_OAUTH_SSO=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_AUDIT_LOGGING=true
FEATURE_ADVANCED_RATE_LIMITING=false
FEATURE_ANALYTICS=false

# SMTP (Gmail) — replace with your Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=VetCare <your-email@gmail.com>

# AI Copilot — paste your own keys here before uploading to Render
# Get free Groq key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
# OpenAI (optional, paid): https://platform.openai.com/settings/billing
OPENAI_API_KEY=your-openai-api-key-here

# Seed demo data on first startup (set to false after first deploy)
SEED_ON_STARTUP=true
