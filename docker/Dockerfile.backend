# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

COPY backend/package*.json ./

RUN npm ci

COPY backend/src ./src
COPY backend/tsconfig.json ./

# Compile TS → JS (production build, no source maps)
RUN npx tsc --sourceMap false --declarationMap false

# Production stage
FROM node:18-alpine

# Security: add non-root user
RUN addgroup -g 1001 -S vetcare && adduser -S vetcare -u 1001 -G vetcare

WORKDIR /app

COPY backend/package*.json ./

RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist ./dist

# Create uploads directory owned by app user
RUN mkdir -p /app/uploads /app/logs && chown -R vetcare:vetcare /app

EXPOSE 3000

ENV NODE_ENV=production

USER vetcare

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/v1/health || exit 1

CMD ["node", "dist/index.js"]
